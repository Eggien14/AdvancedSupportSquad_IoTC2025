# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: Advanced_Support_Squad
label: Advanced_Support_Squad
description: |
  A minimal project structure, that serves as a starting point for custom Bluetooth applications. The application starts advertising after boot and restarts advertising after a connection is closed.
category: Bluetooth Examples
filter:
- name: Device Type
  value: [SoC]
- name: Project Difficulty
  value: [Beginner]
- name: Wireless Technology
  value: [Bluetooth]
package: Bluetooth
quality: experimental
readme:
- {path: readme.md}
- {path: readme.md}
source:
- {path: main.c}
- {path: app.c}
- {path: app_micriumos.c}
tag: ['hardware:rf:band:2400']
include:
- path: .
  file_list:
  - {path: app.h}
sdk: {id: simplicity_sdk, version: 2024.12.2}
toolchain_settings: []
component:
- {from: aiml, id: ml_audio_feature_generation}
- {from: aiml, id: tensorflow_debug_log_iostream}
- {from: aiml, id: tensorflow_lite_micro}
- {from: aiml, id: tensorflow_lite_micro_accelerated_kernels}
- {id: EFR32MG26B510F3200IM68}
- {id: app_assert}
- {id: bluetooth_feature_connection}
- {id: bluetooth_feature_gatt}
- {id: bluetooth_feature_gatt_server}
- {id: bluetooth_feature_legacy_advertiser}
- {id: bluetooth_feature_legacy_scanner}
- {id: bluetooth_feature_sm}
- {id: bluetooth_feature_system}
- {id: bluetooth_stack}
- {id: bootloader_interface}
- {id: brd2608a}
- {id: clock_manager}
- {id: device_init}
- {id: emlib_iadc}
- {id: gatt_configuration}
- {id: gatt_service_device_information}
- instance: [imu]
  id: i2cspm
- {id: in_place_ota_dfu}
- instance: [uart_esp, vcom]
  id: iostream_eusart
- {id: iostream_retarget_stdio}
- {id: memory_manager}
- {id: mic_driver}
- {id: mic_i2s_driver}
- {id: micriumos_kernel}
- {id: mpu}
- {id: rail_util_pti}
- instance: [btn0]
  id: simple_button
- instance: [led0]
  id: simple_led
- {id: sl_common}
- {id: sl_system}
other_file:
- {path: image/readme_img0.png}
- {path: image/readme_img1.png}
- {path: image/readme_img2.png}
- {path: image/readme_img3.png}
- {path: image/readme_img4.png}
configuration:
- {name: SL_STACK_SIZE, value: '2000'}
- {name: LIB_MEM_CFG_HEAP_SIZE, value: '6500'}
- {name: OS_CFG_TMR_EN, value: '1'}
- {name: OS_CFG_DBG_EN, value: '0'}
- {name: OS_CFG_TS_EN, value: '0'}
- {name: OS_CFG_SCHED_ROUND_ROBIN_EN, value: '0'}
- {name: OS_CFG_STK_SIZE_MIN, value: '48'}
- {name: OS_CFG_Q_EN, value: '1'}
- {name: OS_CFG_MON_EN, value: '0'}
- {name: OS_CFG_STAT_TASK_EN, value: '0'}
- {name: OS_CFG_STAT_TASK_STK_CHK_EN, value: '0'}
- {name: OS_CFG_TASK_PROFILE_EN, value: '0'}
- {name: OS_CFG_TASK_Q_EN, value: '0'}
- condition: [psa_crypto]
  name: SL_PSA_KEY_USER_SLOT_COUNT
  value: '0'
ui_hints:
  highlight:
  - {path: config/btconf/gatt_configuration.btconf}
  - {path: readme.md, focus: true}
sdk_extension:
- {id: aiml, version: 2.0.1}
post_build:
- {path: Advanced_Support_Squad.slpb, profile: bt_common}

